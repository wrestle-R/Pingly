<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">
        <ImageView android:id="@+id/widget_surface" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitXY"
            android:src="@drawable/pingora_widget_surface" android:importantForAccessibility="no" />
        <LinearLayout android:id="@id/widget_root" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">
            <LinearLayout android:id="@+id/clipboard_widget_header" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="Clipboard" android:textColor="@color/widget_foreground" android:textStyle="bold"
                    android:textSize="15sp" android:singleLine="true" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/pingora_widget_status" android:drawablePadding="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:singleLine="true" android:ellipsize="end"
                android:textColor="@color/widget_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/pingora_widget_send" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:paddingVertical="6dp"
                android:layout_marginTop="10dp" android:paddingHorizontal="4dp" android:gravity="center"
                android:background="@drawable/pingora_widget_button" android:textColor="@color/widget_on_button"
                android:text="Send clipboard" android:textSize="14sp" android:textStyle="bold"
                android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
