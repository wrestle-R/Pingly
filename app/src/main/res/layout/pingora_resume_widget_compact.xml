<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical">
        <ImageView android:id="@+id/widget_surface" android:layout_width="match_parent"
            android:layout_height="match_parent" android:scaleType="fitXY"
            android:src="@drawable/pingora_widget_surface" android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="60dp" android:gravity="center_vertical"
            android:padding="6dp">
            <TextView android:id="@id/resume_widget_button"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:minHeight="48dp" android:gravity="center" android:paddingHorizontal="4dp"
                android:text="Resume" android:textSize="13sp" android:textStyle="bold"
                android:maxLines="2" android:includeFontPadding="false" android:ellipsize="end" android:textColor="@color/widget_on_button"
                android:background="@drawable/pingora_widget_button" android:contentDescription="Resume InstaBox" />
            <ImageButton android:id="@id/resume_widget_refresh"
                android:layout_width="44dp" android:layout_height="48dp" android:layout_marginStart="6dp"
                android:background="@android:color/transparent" android:src="@drawable/ic_refresh_24dp"
                android:scaleType="center" android:tint="@color/widget_foreground" android:contentDescription="Refresh InstaBox status" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
